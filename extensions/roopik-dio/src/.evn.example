# Roopik Agent Environment Variables
# =================================

# PostHog Analytics (for telemetry)
# Get your API key from httpsposthog.comsignup
# After signup, go to Settings -> Project Settings -> API Keys
# Copy the Project API Key (starts with phc_...)
ROOPIK_POSTHOG_KEY=<KEY>

# PostHog Host (default is US instance, change if using EU)
ROOPIK_POSTHOG_HOST=httpsus.i.posthog.com
