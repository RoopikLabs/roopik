{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": [
		"src/**/*",
		"../../src/vscode-dts/vscode.d.ts"
	],
	"exclude": ["node_modules", "dist"]
}
