{
  "name": "roopik",
  "displayName": "Roopik",
  "description": "AI-native canvas-first IDE for frontend development",
  "version": "0.1.0",
  "publisher": "roopik",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "roopik.openCanvas",
        "title": "Roopik: Dashboard",
        "icon": "$(dashboard)"
      },
      {
        "command": "roopik.newCanvas",
        "title": "Roopik: New Canvas"
      },
      {
        "command": "roopik.showCanvases",
        "title": "Roopik: Show Open Canvases"
      },
      {
        "command": "roopik.closeAllCanvases",
        "title": "Roopik: Close All Canvases"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "roopik",
          "title": "Roopik",
          "icon": "resources/roopik-icon.svg"
        }
      ]
    },
    "views": {
      "roopik": [
        {
          "id": "roopik.dashboard",
          "name": "Dashboard",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "roopik.openCanvas",
          "when": "view == roopik.dashboard",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "22.x"
  }
}
