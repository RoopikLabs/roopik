{
	"name": "@roopik/evals",
	"version": "0.1.0",
	"description": "Evaluation suite for Roopik IDE agent capabilities",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "tsc",
		"test": "node --loader ts-node/esm src/index.ts",
		"test:ipc": "dotenvx run -f .env -- tsx src/index-ipc.ts",
		"test:canvas": "node --loader ts-node/esm src/index.ts --eval canvas-creation",
		"report": "tsx src/cli/report.ts",
		"clean": "rimraf dist"
	},
	"dependencies": {
		"@vscode/test-electron": "^2.3.8",
		"chalk": "^5.3.0",
		"@roo-code/ipc": "workspace:*",
		"@roo-code/types": "workspace:*",
		"p-wait-for": "^5.0.2"
	},
	"devDependencies": {
		"@dotenvx/dotenvx": "^1.31.0",
		"@types/glob": "^9.0.0",
		"@types/mocha": "^10.0.10",
		"@types/node": "^20.11.5",
		"@types/vscode": "^1.85.0",
		"glob": "^13.0.0",
		"mocha": "^11.7.5",
		"ts-node": "^10.9.2",
		"tsx": "^4.19.2",
		"typescript": "^5.3.3"
	}
}
