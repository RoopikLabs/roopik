{
	"name": "roopik-zoo",
	"displayName": "Zoo Code (Roopik)",
	"description": "%extension.description%",
	"publisher": "roopik",
	"version": "3.70.0",
	"icon": "dist/assets/icons/icon.png",
	"galleryBanner": {
		"color": "#617A91",
		"theme": "dark"
	},
	"engines": {
		"vscode": "^1.100.0",
		"node": "20.20.2"
	},
	"author": {
		"name": "Zoo Code"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Zoo-Code-Org/Zoo-Code"
	},
	"homepage": "https://zoocode.dev",
	"categories": [
		"AI",
		"Chat",
		"Programming Languages",
		"Education",
		"Snippets",
		"Testing"
	],
	"keywords": [
		"cline",
		"claude",
		"dev",
		"mcp",
		"openrouter",
		"coding",
		"agent",
		"autonomous",
		"chatgpt",
		"sonnet",
		"ai",
		"llama",
		"zoo code",
		"zoocode"
	],
	"activationEvents": [
		"onLanguage",
		"onStartupFinished"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "roopik-zoo-ActivityBar",
					"title": "%views.activitybar.title%",
					"icon": "dist/assets/icons/icon.svg"
				}
			],
			"secondarySidebar": [
				{
					"id": "roopik-zoo-AuxiliaryBar",
					"title": "Zoo Code (Roopik)",
					"icon": "dist/assets/icons/icon.svg"
				}
			]
		},
		"views": {
			"roopik-zoo-ActivityBar": [
				{
					"type": "webview",
					"id": "roopik-zoo.SidebarProvider",
					"name": "%views.sidebar.name%"
				}
			],
			"roopik-zoo-AuxiliaryBar": [
				{
					"type": "webview",
					"id": "roopik-zoo.ChatPanel",
					"name": "Chat"
				}
			]
		},
		"commands": [
			{
				"command": "roopik-zoo.openChatPanel",
				"title": "Open Roopik Zoo Chat",
				"category": "Roopik Zoo",
				"icon": {
					"light": "dist/assets/icons/roopik-zoo-icon-light.svg",
					"dark": "dist/assets/icons/roopik-zoo-icon-dark.svg"
				}
			},
			{
				"command": "roopik-zoo.plusButtonClicked",
				"title": "%command.newTask.title%",
				"icon": "$(edit)"
			},
			{
				"command": "roopik-zoo.historyButtonClicked",
				"title": "%command.history.title%",
				"icon": "$(history)"
			},
			{
				"command": "roopik-zoo.marketplaceButtonClicked",
				"title": "%command.marketplace.title%",
				"icon": "$(extensions)"
			},
			{
				"command": "roopik-zoo.popoutButtonClicked",
				"title": "%command.openInEditor.title%",
				"icon": "$(link-external)"
			},
			{
				"command": "roopik-zoo.settingsButtonClicked",
				"title": "%command.settings.title%",
				"icon": "$(settings-gear)"
			},
			{
				"command": "roopik-zoo.openInNewTab",
				"title": "%command.openInNewTab.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "roopik-zoo.explainCode",
				"title": "%command.explainCode.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "roopik-zoo.fixCode",
				"title": "%command.fixCode.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "roopik-zoo.improveCode",
				"title": "%command.improveCode.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "roopik-zoo.addToContext",
				"title": "%command.addToContext.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "roopik-zoo.newTask",
				"title": "%command.newTask.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "roopik-zoo.externalContext",
				"title": "Add External Context to Roopik Zoo",
				"category": "%configuration.title%"
			},
			{
				"command": "roopik-zoo.terminalAddToContext",
				"title": "%command.terminal.addToContext.title%",
				"category": "Terminal"
			},
			{
				"command": "roopik-zoo.terminalFixCommand",
				"title": "%command.terminal.fixCommand.title%",
				"category": "Terminal"
			},
			{
				"command": "roopik-zoo.terminalExplainCommand",
				"title": "%command.terminal.explainCommand.title%",
				"category": "Terminal"
			},
			{
				"command": "roopik-zoo.setCustomStoragePath",
				"title": "%command.setCustomStoragePath.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "roopik-zoo.importSettings",
				"title": "%command.importSettings.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "roopik-zoo.focusInput",
				"title": "%command.focusInput.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "roopik-zoo.acceptInput",
				"title": "%command.acceptInput.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "roopik-zoo.toggleAutoApprove",
				"title": "%command.toggleAutoApprove.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "roopik-zoo.showRipgrepDiagnostic",
				"title": "%command.showRipgrepDiagnostic.title%",
				"category": "%configuration.title%"
			}
		],
		"menus": {
			"layoutControl": [
				{
					"command": "roopik-zoo.openChatPanel",
					"group": "navigation",
					"order": 0
				}
			],
			"editor/context": [
				{
					"submenu": "roopik-zoo.contextMenu",
					"group": "1"
				}
			],
			"roopik-zoo.contextMenu": [
				{
					"command": "roopik-zoo.addToContext",
					"group": "1_actions@1"
				},
				{
					"command": "roopik-zoo.explainCode",
					"group": "1_actions@2"
				},
				{
					"command": "roopik-zoo.improveCode",
					"group": "1_actions@3"
				},
				{
					"command": "roopik-zoo.fixCode",
					"group": "1_actions@4"
				}
			],
			"terminal/context": [
				{
					"submenu": "roopik-zoo.terminalMenu",
					"group": "2"
				}
			],
			"roopik-zoo.terminalMenu": [
				{
					"command": "roopik-zoo.terminalAddToContext",
					"group": "1_actions@1"
				},
				{
					"command": "roopik-zoo.terminalFixCommand",
					"group": "1_actions@2"
				},
				{
					"command": "roopik-zoo.terminalExplainCommand",
					"group": "1_actions@3"
				}
			],
			"view/title": [
				{
					"command": "roopik-zoo.plusButtonClicked",
					"group": "navigation@1",
					"when": "view == roopik-zoo.SidebarProvider"
				},
				{
					"command": "roopik-zoo.settingsButtonClicked",
					"group": "navigation@2",
					"when": "view == roopik-zoo.SidebarProvider"
				},
				{
					"command": "roopik-zoo.marketplaceButtonClicked",
					"group": "navigation@3",
					"when": "view == roopik-zoo.SidebarProvider"
				},
				{
					"command": "roopik-zoo.historyButtonClicked",
					"group": "overflow@1",
					"when": "view == roopik-zoo.SidebarProvider"
				},
				{
					"command": "roopik-zoo.popoutButtonClicked",
					"group": "overflow@2",
					"when": "view == roopik-zoo.SidebarProvider"
				},
				{
					"command": "roopik-zoo.plusButtonClicked",
					"group": "navigation@1",
					"when": "view == roopik-zoo.ChatPanel"
				},
				{
					"command": "roopik-zoo.settingsButtonClicked",
					"group": "navigation@2",
					"when": "view == roopik-zoo.ChatPanel"
				},
				{
					"command": "roopik-zoo.marketplaceButtonClicked",
					"group": "navigation@3",
					"when": "view == roopik-zoo.ChatPanel"
				},
				{
					"command": "roopik-zoo.historyButtonClicked",
					"group": "overflow@1",
					"when": "view == roopik-zoo.ChatPanel"
				},
				{
					"command": "roopik-zoo.popoutButtonClicked",
					"group": "overflow@2",
					"when": "view == roopik-zoo.ChatPanel"
				}
			],
			"editor/title": [
				{
					"command": "roopik-zoo.plusButtonClicked",
					"group": "navigation@1",
					"when": "activeWebviewPanelId == roopik-zoo.TabPanelProvider"
				},
				{
					"command": "roopik-zoo.settingsButtonClicked",
					"group": "navigation@2",
					"when": "activeWebviewPanelId == roopik-zoo.TabPanelProvider"
				},
				{
					"command": "roopik-zoo.marketplaceButtonClicked",
					"group": "navigation@3",
					"when": "activeWebviewPanelId == roopik-zoo.TabPanelProvider"
				},
				{
					"command": "roopik-zoo.historyButtonClicked",
					"group": "overflow@1",
					"when": "activeWebviewPanelId == roopik-zoo.TabPanelProvider"
				},
				{
					"command": "roopik-zoo.popoutButtonClicked",
					"group": "overflow@2",
					"when": "activeWebviewPanelId == roopik-zoo.TabPanelProvider"
				}
			]
		},
		"keybindings": [
			{
				"command": "roopik-zoo.openChatPanel",
				"key": "ctrl+alt+b",
				"mac": "cmd+alt+b",
				"win": "ctrl+alt+b",
				"linux": "ctrl+alt+b"
			},
			{
				"command": "roopik-zoo.addToContext",
				"key": "cmd+k cmd+a",
				"mac": "cmd+k cmd+a",
				"win": "ctrl+k ctrl+a",
				"linux": "ctrl+k ctrl+a",
				"when": "editorTextFocus && editorHasSelection"
			},
			{
				"command": "roopik-zoo.toggleAutoApprove",
				"key": "cmd+alt+a",
				"mac": "cmd+alt+a",
				"win": "ctrl+alt+a",
				"linux": "ctrl+alt+a"
			}
		],
		"submenus": [
			{
				"id": "roopik-zoo.contextMenu",
				"label": "%views.contextMenu.label%"
			},
			{
				"id": "roopik-zoo.terminalMenu",
				"label": "%views.terminalMenu.label%"
			}
		],
		"configuration": {
			"title": "%configuration.title%",
			"properties": {
				"roopik-zoo.allowedCommands": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [
						"git log",
						"git diff",
						"git show"
					],
					"description": "%commands.allowedCommands.description%"
				},
				"roopik-zoo.deniedCommands": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [],
					"description": "%commands.deniedCommands.description%"
				},
				"roopik-zoo.commandExecutionTimeout": {
					"type": "number",
					"default": 0,
					"minimum": 0,
					"maximum": 600,
					"description": "%commands.commandExecutionTimeout.description%"
				},
				"roopik-zoo.commandTimeoutAllowlist": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [],
					"description": "%commands.commandTimeoutAllowlist.description%"
				},
				"roopik-zoo.preventCompletionWithOpenTodos": {
					"type": "boolean",
					"default": false,
					"description": "%commands.preventCompletionWithOpenTodos.description%"
				},
				"roopik-zoo.vsCodeLmModelSelector": {
					"type": "object",
					"properties": {
						"vendor": {
							"type": "string",
							"description": "%settings.vsCodeLmModelSelector.vendor.description%"
						},
						"family": {
							"type": "string",
							"description": "%settings.vsCodeLmModelSelector.family.description%"
						}
					},
					"description": "%settings.vsCodeLmModelSelector.description%"
				},
				"roopik-zoo.customStoragePath": {
					"type": "string",
					"default": "",
					"description": "%settings.customStoragePath.description%"
				},
				"roopik-zoo.enableCodeActions": {
					"type": "boolean",
					"default": true,
					"description": "%settings.enableCodeActions.description%"
				},
				"roopik-zoo.autoImportSettingsPath": {
					"type": "string",
					"default": "",
					"description": "%settings.autoImportSettingsPath.description%"
				},
				"roopik-zoo.maximumIndexedFilesForFileSearch": {
					"type": "number",
					"default": 10000,
					"minimum": 5000,
					"maximum": 500000,
					"description": "%settings.maximumIndexedFilesForFileSearch.description%"
				},
				"roopik-zoo.useAgentRules": {
					"type": "boolean",
					"default": true,
					"description": "%settings.useAgentRules.description%"
				},
				"roopik-zoo.apiRequestTimeout": {
					"type": "integer",
					"default": 600,
					"minimum": 1,
					"maximum": 3600,
					"description": "%settings.apiRequestTimeout.description%"
				},
				"roopik-zoo.newTaskRequireTodos": {
					"type": "boolean",
					"default": false,
					"description": "%settings.newTaskRequireTodos.description%"
				},
				"roopik-zoo.codeIndex.embeddingBatchSize": {
					"type": "number",
					"default": 60,
					"minimum": 1,
					"maximum": 200,
					"description": "%settings.codeIndex.embeddingBatchSize.description%"
				},
				"roopik-zoo.debug": {
					"type": "boolean",
					"default": false,
					"description": "%settings.debug.description%"
				},
				"roopik-zoo.debugProxy.enabled": {
					"type": "boolean",
					"default": false,
					"description": "%settings.debugProxy.enabled.description%",
					"markdownDescription": "%settings.debugProxy.enabled.description%"
				},
				"roopik-zoo.debugProxy.serverUrl": {
					"type": "string",
					"default": "http://127.0.0.1:8888",
					"description": "%settings.debugProxy.serverUrl.description%",
					"markdownDescription": "%settings.debugProxy.serverUrl.description%"
				},
				"roopik-zoo.debugProxy.tlsInsecure": {
					"type": "boolean",
					"default": false,
					"description": "%settings.debugProxy.tlsInsecure.description%",
					"markdownDescription": "%settings.debugProxy.tlsInsecure.description%"
				},
				"roopik-zoo.workspace.rootResolution": {
					"type": "string",
					"enum": [
						"activeEditor",
						"firstFolder"
					],
					"enumDescriptions": [
						"%settings.workspace.rootResolution.activeEditor.description%",
						"%settings.workspace.rootResolution.firstFolder.description%"
					],
					"default": "activeEditor",
					"scope": "machine",
					"description": "%settings.workspace.rootResolution.description%",
					"markdownDescription": "%settings.workspace.rootResolution.description%"
				}
			}
		}
	},
	"scripts": {
		"lint": "eslint . --ext=ts --max-warnings=0",
		"check-types": "tsc --noEmit",
		"pretest": "turbo run bundle --cwd ..",
		"pretest:coverage": "turbo run bundle --cwd ..",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"format": "prettier --write .",
		"bundle": "node esbuild.mjs",
		"build:packages": "cd packages/types && npm install && npm run build && cd ../build && npm install && npm run build",
		"build": "npm run clean && npm run build:webview && npm run bundle",
		"build:all": "npm run build:packages && npm run build",
		"build:webview": "cd webview-ui && npm install && npm run build",
		"postinstall": "npm run build:packages",
		"vscode:prepublish": "pnpm bundle --production",
		"vsix": "mkdirp ../bin && vsce package --no-dependencies --out ../bin",
		"publish:vsce": "npx @vscode/vsce publish --packagePath ../bin/zoo-code-$npm_package_version.vsix",
		"publish:ovsx": "pnpm exec ovsx publish ../bin/zoo-code-$npm_package_version.vsix --skip-duplicate",
		"publish:marketplace": "pnpm vsix && pnpm publish:vsce && pnpm publish:ovsx",
		"watch:bundle": "pnpm bundle --watch",
		"watch:tsc": "cd .. && tsc --noEmit --watch --project src/tsconfig.json",
		"clean": "rimraf dist src/dist logs mock .turbo"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.109.0",
		"@anthropic-ai/vertex-sdk": "^0.19.0",
		"@aws-sdk/client-bedrock-runtime": "^3.922.0",
		"@aws-sdk/credential-providers": "^3.922.0",
		"@dotenvx/dotenvx": "^1.51.4",
		"@google/genai": "^1.29.1",
		"@lmstudio/sdk": "^1.1.1",
		"@mistralai/mistralai": "^1.9.18",
		"@modelcontextprotocol/sdk": "1.29.0",
		"@qdrant/js-client-rest": "^1.14.0",
		"@roo-code/cloud": "file:./packages/cloud",
		"@roo-code/core": "file:./packages/core",
		"@roo-code/ipc": "file:./packages/ipc",
		"@roo-code/telemetry": "file:./packages/telemetry",
		"@roo-code/types": "file:./packages/types",
		"ai-sdk-provider-poe": "2.0.18",
		"async-mutex": "^0.5.0",
		"axios": "^1.18.1",
		"chokidar": "^4.0.1",
		"clone-deep": "^4.0.1",
		"delay": "^6.0.0",
		"diff": "^5.2.0",
		"exceljs": "^4.4.0",
		"fast-deep-equal": "^3.1.3",
		"fastest-levenshtein": "^1.0.16",
		"fzf": "^0.5.2",
		"get-folder-size": "^5.0.0",
		"global-agent": "^3.0.0",
		"google-auth-library": "^10.2.0",
		"gray-matter": "^4.0.3",
		"i18next": "^25.0.0",
		"ignore": "^7.0.3",
		"isbinaryfile": "^5.0.7",
		"json-stream-stringify": "^3.1.7",
		"lodash.debounce": "^4.0.8",
		"mammoth": "^1.9.1",
		"monaco-vscode-textmate-theme-converter": "^0.1.7",
		"node-cache": "^5.1.2",
		"ollama": "^0.6.0",
		"openai": "^5.12.2",
		"os-name": "^6.0.0",
		"p-limit": "^6.2.0",
		"p-wait-for": "^5.0.2",
		"partial-json": "^0.1.7",
		"pdf-parse": "^1.1.1",
		"pretty-bytes": "^7.0.0",
		"proper-lockfile": "^4.1.2",
		"ps-tree": "^1.2.0",
		"reconnecting-eventsource": "^1.6.5",
		"safe-stable-stringify": "^2.5.0",
		"sanitize-filename": "^1.6.4",
		"say": "^0.16.0",
		"semver-compare": "^1.0.0",
		"serialize-error": "^12.0.0",
		"shell-quote": "^1.8.2",
		"simple-git": "^3.27.0",
		"strip-bom": "^5.0.0",
		"tiktoken": "^1.0.21",
		"tree-sitter-wasms": "^0.1.13",
		"undici": "^6.21.3",
		"uuid": "^11.1.0",
		"vscode-material-icons": "^0.1.1",
		"web-tree-sitter": "^0.25.6",
		"workerpool": "^9.2.0",
		"yaml": "^2.8.0",
		"zod": "3.25.76",
		"dotenv": "^17.4.2"
	},
	"devDependencies": {
		"@ai-sdk/openai-compatible": "2.0.56",
		"@roo-code/build": "file:./packages/build",
		"@roo-code/config-eslint": "file:./packages/config-eslint",
		"@roo-code/config-typescript": "file:./packages/config-typescript",
		"@types/clone-deep": "4.0.4",
		"@types/diff": "5.2.3",
		"@types/lodash.debounce": "4.0.9",
		"@types/node": "20.19.43",
		"@types/node-cache": "4.2.5",
		"@types/proper-lockfile": "4.1.4",
		"@types/ps-tree": "1.1.6",
		"@types/semver-compare": "1.0.3",
		"@types/shell-quote": "1.7.5",
		"@types/vscode": "1.100.0",
		"@vscode/vsce": "3.9.2",
		"ai": "6.0.218",
		"esbuild-wasm": "0.25.12",
		"execa": "9.6.1",
		"mkdirp": "3.0.1",
		"nock": "14.0.15",
		"ovsx": "0.10.12",
		"rimraf": "6.0.1",
		"typescript": "^5.8.3",
		"@vitest/coverage-v8": "4.1.9",
		"vitest": "4.1.9"
	},
	"__metadata": {
		"id": "roopik.roopik-zoo",
		"publisherId": "roopik",
		"publisherDisplayName": "Roopik",
		"isBuiltin": false,
		"isUninstallable": false
	}
}
