{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "DevTools Extensions Manifest",
	"description": "Configuration file for Roopik DevTools extensions",
	"type": "object",
	"properties": {
		"$schema": {
			"type": "string",
			"description": "JSON schema reference"
		},
		"description": {
			"type": "string",
			"description": "Description of this manifest file"
		},
		"instructions": {
			"type": "object",
			"description": "Instructions for adding extensions",
			"properties": {
				"howToAdd": {
					"type": "array",
					"items": { "type": "string" },
					"description": "Steps to add a new extension"
				},
				"supportedExtensions": {
					"type": "array",
					"items": { "type": "string" },
					"description": "List of supported extension types"
				},
				"notSupported": {
					"type": "array",
					"items": { "type": "string" },
					"description": "List of unsupported features"
				}
			}
		},
		"extensions": {
			"type": "array",
			"description": "List of DevTools extensions to load",
			"items": {
				"type": "object",
				"required": ["name", "path", "enabled"],
				"properties": {
					"name": {
						"type": "string",
						"description": "Display name of the extension"
					},
					"path": {
						"type": "string",
						"description": "Folder name containing the unpacked extension (relative to this manifest)"
					},
					"enabled": {
						"type": "boolean",
						"description": "Whether to load this extension"
					},
					"description": {
						"type": "string",
						"description": "Brief description of what the extension does"
					},
					"chromeWebStoreId": {
						"type": "string",
						"description": "Chrome Web Store extension ID (for reference/updates)"
					}
				}
			}
		}
	},
	"required": ["extensions"]
}
