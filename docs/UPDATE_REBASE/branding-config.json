{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "description": "Roopik IDE Branding Configuration - Centralized place for all branding data",
  "version": "1.0.0",
  "product": {
    "nameShort": "Roopik",
    "nameLong": "Roopik",
    "applicationName": "roopik",
    "dataFolderName": ".roopik",
    "win32DirName": "Roopik",
    "win32NameVersion": "Roopik",
    "win32RegValueName": "Roopik",
    "win32MutexName": "roopik",
    "win32AppUserModelId": "Roopik",
    "win32ShellNameShort": "Ro&opik",
    "win32TunnelServiceMutex": "roopik-tunnelservice",
    "win32TunnelMutex": "roopik-tunnel",
    "win32ContextMenu": {
      "x64": {
        "clsid": "A8F3C9E1-5B2D-4F7A-9C3E-1D6A8B4E7F2C"
      },
      "arm64": {
        "clsid": "B7E4D2F3-6C1A-4E8B-8D2F-3E7C9A5F8D1B"
      }
    },
    "darwinBundleIdentifier": "com.roopik.code",
    "linuxIconName": "roopik-editor",
    "urlProtocol": "roopik",
    "serverApplicationName": "roopik-server",
    "serverDataFolderName": ".roopik-server",
    "tunnelApplicationName": "roopik-tunnel",
    "reportIssueUrl": "https://github.com/RoopikHQ/roopik/issues/new",
    "linkProtectionTrustedDomains": [
      "https://roopik.com",
      "https://www.roopik.com",
      "https://github.com/RoopikHQ/roopik"
    ]
  },
  "package": {
    "name": "roopik-dev",
    "author": {
      "name": "Roopik Labs"
    },
    "repository": {
      "type": "git",
      "url": "https://github.com/RoopikHQ/roopik.git"
    },
    "bugs": {
      "url": "https://github.com/RoopikHQ/roopik/issues"
    }
  },
  "windows": {
    "visualElementsManifest": {
      "shortDisplayName": "Roopik"
    },
    "installer": {
      "publisher": "Roopik Labs",
      "publisherUrl": "https://roopik.com",
      "supportUrl": "https://roopik.com/support",
      "updatesUrl": "https://roopik.com/updates"
    }
  },
  "linux": {
    "desktop": {
      "comment": "AI-Native Canvas-First IDE"
    }
  },
  "server": {
    "manifest": {
      "name": "Roopik",
      "shortName": "Roopik"
    }
  },
  "icons": {
    "win32": [
      {
        "source": "code.ico",
        "target": "roopik.ico",
        "description": "Windows main application icon",
        "required": true,
        "sizes": "16x16, 32x32, 48x48, 256x256",
        "format": "ico"
      },
      {
        "source": "code_150x150.png",
        "target": "roopik_150x150.png",
        "description": "Windows tile icon (150x150)",
        "required": true,
        "sizes": "150x150",
        "format": "png"
      },
      {
        "source": "code_70x70.png",
        "target": "roopik_70x70.png",
        "description": "Windows tile icon (70x70)",
        "required": true,
        "sizes": "70x70",
        "format": "png"
      }
    ],
    "darwin": [
      {
        "source": "code.icns",
        "target": "roopik.icns",
        "description": "macOS application icon bundle",
        "required": true,
        "sizes": "16x16 to 1024x1024",
        "format": "icns"
      }
    ],
    "linux": [
      {
        "source": "code.png",
        "target": "roopik.png",
        "description": "Linux desktop icon",
        "required": true,
        "sizes": "512x512 recommended",
        "format": "png"
      }
    ],
    "server": [
      {
        "source": "code-192.png",
        "target": "roopik-192.png",
        "description": "PWA icon (192x192)",
        "required": true,
        "sizes": "192x192",
        "format": "png"
      },
      {
        "source": "code-512.png",
        "target": "roopik-512.png",
        "description": "PWA icon (512x512)",
        "required": true,
        "sizes": "512x512",
        "format": "png"
      },
      {
        "source": "favicon.ico",
        "target": "roopik-favicon.ico",
        "description": "Browser favicon",
        "required": true,
        "sizes": "16x16 or 32x32",
        "format": "ico"
      }
    ],
    "workbench": [
      {
        "source": "code-icon.svg",
        "target": "roopik-icon.svg",
        "description": "Workbench SVG icon (used in welcome pages)",
        "required": true,
        "sizes": "scalable",
        "format": "svg"
      }
    ],
    "extensions": [
      {
        "source": "extensions/github-authentication/media/favicon.ico",
        "target": "roopik-favicon.ico",
        "description": "GitHub authentication extension favicon",
        "required": false,
        "sizes": "16x16 or 32x32",
        "format": "ico"
      },
      {
        "source": "extensions/microsoft-authentication/media/favicon.ico",
        "target": "roopik-favicon.ico",
        "description": "Microsoft authentication extension favicon",
        "required": false,
        "sizes": "16x16 or 32x32",
        "format": "ico"
      }
    ]
  },
  "textReplacements": [
    {
      "file": "resources/win32/VisualElementsManifest.xml",
      "description": "Windows tile manifest",
      "replacements": [
        {
          "search": "ShortDisplayName=\"Code - OSS\"",
          "replace": "ShortDisplayName=\"Roopik\""
        }
      ]
    },
    {
      "file": "resources/linux/code.desktop",
      "description": "Linux desktop entry",
      "replacements": [
        {
          "search": "Comment=Code Editing. Redefined.",
          "replace": "Comment=AI-Native Canvas-First IDE"
        }
      ]
    },
    {
      "file": "build/win32/code.iss",
      "description": "Windows installer output filename",
      "replacements": [
        {
          "search": "OutputBaseFilename=VSCodeSetup",
          "replace": "OutputBaseFilename=RoopikSetup"
        }
      ]
    },
    {
      "file": "src/vs/platform/update/electron-main/updateService.win32.ts",
      "description": "Windows update cache path - use product name instead of 'vscode' to prevent conflicts",
      "replacements": [
        {
          "search": "const result = path.join(tmpdir(), `vscode-${this.productService.quality}-${this.productService.target}-${process.arch}`);",
          "replace": "const result = path.join(tmpdir(), `${this.productService.applicationName}-${this.productService.quality}-${this.productService.target}-${process.arch}`);"
        }
      ]
    },
    {
      "file": "src/vs/platform/update/electron-main/updateService.darwin.ts",
      "description": "macOS update service - make initialization non-fatal to keep button visible",
      "replacements": [
        {
          "search": "this.logService.error('Failed to set update feed URL', e);\n\t\t\treturn undefined;",
          "replace": "this.logService.warn('Failed to set update feed URL during initialization', e);\n\t\t\treturn url;"
        }
      ]
    },
    {
      "file": "src/vs/platform/telemetry/common/telemetryService.ts",
      "description": "Telemetry defaults - set to OFF for privacy-first approach",
      "replacements": [
        {
          "search": "'default': TelemetryConfiguration.ON,",
          "replace": "'default': TelemetryConfiguration.OFF,"
        },
        {
          "search": "\t\t\t'default': true,\n\t\t\t'restricted': true,\n\t\t\t'scope': ConfigurationScope.APPLICATION,\n\t\t\t'tags': ['usesOnlineServices', 'telemetry'],\n\t\t\t'ignoreSync': true\n\t\t},\n\t\t'telemetry.enableCrashReporter': {",
          "replace": "\t\t\t'default': false,\n\t\t\t'restricted': true,\n\t\t\t'scope': ConfigurationScope.APPLICATION,\n\t\t\t'tags': ['usesOnlineServices', 'telemetry'],\n\t\t\t'ignoreSync': true\n\t\t},\n\t\t'telemetry.enableCrashReporter': {"
        }
      ]
    }
  ],
  "dependencies": {
    "description": "Roopik-specific dependencies to add to package.json",
    "packages": [
      {
        "name": "esbuild",
        "reason": "JavaScript/TypeScript bundler for sandbox component transformation"
      },
      {
        "name": "esbuild-plugin-vue3",
        "reason": "ESBuild plugin to compile Vue 3 SFC (.vue files)"
      },
      {
        "name": "esbuild-svelte",
        "reason": "ESBuild plugin to compile Svelte components (.svelte files)"
      },
      {
        "name": "svelte",
        "reason": "Svelte 5 compiler (required by esbuild-svelte)"
      },
      {
        "name": "@vue/compiler-sfc",
        "reason": "Vue 3 SFC compiler (peer dependency of esbuild-plugin-vue3)"
      },
      {
        "name": "esbuild-plugin-solid",
        "reason": "ESBuild plugin to compile SolidJS components (.jsx/.tsx)"
      },
      {
        "name": "electron-context-menu",
        "reason": "Standard browser context menu for ProjectMode BrowserView"
      },
      {
        "name": "@modelcontextprotocol/sdk",
        "reason": "Model Context Protocol SDK for MCP server integration"
      },
      {
        "name": "zod",
        "reason": "TypeScript-first schema validation with static type inference"
      },
			{
				"name": "ws",
				"reason": "WebSocket library for MCP stdio server"
			}
    ]
  },
  "devDependencies": {
    "description": "Roopik-specific dev dependencies to add to package.json devDependencies",
    "packages": [
      {
        "name": "@babel/core",
        "reason": "Babel core for AST parsing in component source tracking"
      },
      {
        "name": "@types/babel__core",
        "reason": "TypeScript type definitions for @babel/core"
      },
      {
        "name": "@mdn/browser-compat-data",
        "reason": "FOr access to browser compatibility data and html/svg tags information"
      },
			{
				"name": "@types/ws",
				"reason": "websocket for the MCP stdio server"
			}
    ]
  },
  "scripts": {
    "description": "Roopik-specific npm scripts to add to package.json",
    "entries": [
      {
        "name": "generate-dom-whitelist",
        "command": "node build/scripts/generateDOMWhitelist.mjs",
        "reason": "Generates DOM whitelist for Roopik browser preview security"
      }
    ]
  }
}
